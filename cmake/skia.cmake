set(AURA_SKIA_ROOT "${PROJECT_SOURCE_DIR}/third_party/src/skia")
if(WIN32)
  set(AURA_SKIA_LIBRARY "${PROJECT_SOURCE_DIR}/third_party/skia-build/windows64/skia.lib")
else()
  set(AURA_SKIA_LIBRARY "${PROJECT_SOURCE_DIR}/third_party/skia-build/linux64/libskia.a")
endif()
if(NOT EXISTS "${AURA_SKIA_LIBRARY}")
  message(FATAL_ERROR "Missing Skia library. Run python scripts/bootstrap.py")
endif()
add_library(aura_skia STATIC IMPORTED)
set_property(TARGET aura_skia PROPERTY INTERFACE_COMPILE_DEFINITIONS SK_GANESH SK_GL)
set_target_properties(aura_skia PROPERTIES IMPORTED_LOCATION "${AURA_SKIA_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${AURA_SKIA_ROOT}")
if(WIN32)
  set_property(TARGET aura_skia PROPERTY INTERFACE_LINK_LIBRARIES dwrite windowscodecs ole32 user32 gdi32)
endif()
