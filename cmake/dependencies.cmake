function(aura_dependency name)
  if(NOT EXISTS "${PROJECT_SOURCE_DIR}/third_party/src/${name}/CMakeLists.txt")
    message(FATAL_ERROR "Missing ${name}. Run python scripts/bootstrap.py --fetch-only first.")
  endif()
endfunction()
set(SPDLOG_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(TOMLPLUSPLUS_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(TOMLPLUSPLUS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
foreach(name IN ITEMS spdlog tomlplusplus)
  aura_dependency(${name})
  add_subdirectory("${PROJECT_SOURCE_DIR}/third_party/src/${name}" "third_party/${name}" EXCLUDE_FROM_ALL)
endforeach()
if(BUILD_TESTING)
  aura_dependency(googletest)
  set(BUILD_GMOCK OFF CACHE BOOL "" FORCE)
  set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
  add_subdirectory("${PROJECT_SOURCE_DIR}/third_party/src/googletest" "third_party/googletest" EXCLUDE_FROM_ALL)
endif()
