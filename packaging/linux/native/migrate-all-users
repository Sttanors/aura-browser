#!/bin/sh
# Package post-install entry point. All home modifications run with that user's uid.
set -eu
[ "$(id -u)" = 0 ] || exit 0
command -v runuser >/dev/null 2>&1 || exit 0
getent passwd | while IFS=: read -r name password uid gid description home shell; do
    case $uid in ''|*[!0-9]*) continue;; esac
    [ "$uid" -ge 1000 ] && [ "$uid" -lt 65534 ] || continue
    case $home in /*) ;; *) continue;; esac
    [ -d "$home" ] || continue
    # No privileged writes through user-controlled home symlinks. Drop uid first.
    runuser -u "$name" -- env HOME="$home" XDG_DATA_HOME="$home/.local/share" \
        /usr/lib/aura-browser/migrate-launchers || \
        printf 'Aura: launcher migration for %s needs a manual retry.\n' "$name" >&2
done
