FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang cmake ninja-build python3 pkg-config git \
    libx11-dev libxext-dev libxpresent-dev libxrandr-dev libegl-dev libgles-dev \
    libwayland-dev libssl-dev libarchive-dev libgtk-3-0t64 libnss3 libnspr4 \
    libasound2t64 libgbm1 libcups2t64 libxkbcommon0 dpkg-dev rpm zstd \
    desktop-file-utils xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends libarchive-tools \
 && rm -rf /var/lib/apt/lists/*
